    "pages": [
      {
        "status": 200,
        "body": "{\"access_token\":\"new-access\",\"expires_in\":1800}"
      }
    ],
    "requests": [
      {
        "path": "/v1/oauth/token",
        "method": "POST",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "Authorization": "Basic dGVzdC1hcHA6dGVzdC1zZWNyZXQ="
        },
        "body": "grant_type=refresh_token&refresh_token=old-refresh"
      }
    ],
    "saved": [
      {
        "appKey": "test-app",
        "secret": "test-secret",
        "access_token": "new-access",
        "refresh_token": "old-refresh",
        "expires_at": 1900000,
        "accountHashValue": "test-account"
      }
    ],
    "result": {
      "appKey": "test-app",
      "secret": "test-secret",
      "access_token": "new-access",
      "refresh_token": "old-refresh",
      "expires_at": 1900000,
      "accountHashValue": "test-account"
    }
  },
