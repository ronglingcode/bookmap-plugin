    "kind": "oauth",
    "name": "refresh uses broker expiry and preserves old refresh token when omitted",
    "method": "refresh",
    "args": [],
    "credentials": {
      "appKey": "test-app",
      "secret": "test-secret",
      "access_token": "old-access",
      "refresh_token": "old-refresh",
      "expires_at": 0,
      "accountHashValue": "test-account"
